# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reproducible model/runtime artifacts generated by npm run setup:studio
/public/models/modnet/model.onnx
/public/models/esrgan-slim/
/public/models/realesrgan/*.onnx
/public/models/realesrgan/*.data
/public/models/birefnet/model.part*
/public/models/restoration/*.part*
/temp/models/
/temp/ai-enhance.png
/temp/birefnet-result.png
/temp/restoration/
/temp/lighthouse-seo.json
/public/wasm/*.wasm
/public/wasm/*.mjs
/public/codecs/*.wasm
/public/ocr/*.tar
/public/ocr/*.wasm
/public/ocr/*.mjs
/public/ocr/paddle-worker.js
/public/sw.js
!/.env.example
